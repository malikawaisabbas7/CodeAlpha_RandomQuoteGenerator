<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    tools:context=".MainActivity">

    <!-- Decorative top circle -->
    <View
        android:id="@+id/view_circle_top"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/shape_circle_accent"
        android:alpha="0.08"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="-60dp"
        android:layout_marginEnd="-60dp"/>

    <!-- App Label -->
    <TextView
        android:id="@+id/tv_app_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DAILY QUOTE"
        android:textColor="@color/white_60"
        android:textSize="11sp"
        android:letterSpacing="0.25"
        android:fontFamily="@font/poppins_medium"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="56dp"
        android:layout_marginStart="28dp"/>

    <!-- App Title -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Inspire Me"
        android:textColor="@color/white"
        android:textSize="32sp"
        android:fontFamily="@font/poppins_bold"
        app:layout_constraintTop_toBottomOf="@id/tv_app_label"
        app:layout_constraintStart_toStartOf="@id/tv_app_label"
        android:layout_marginTop="4dp"/>

    <!-- Quote Counter e.g. 1 / 30 -->
    <TextView
        android:id="@+id/tv_quote_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1 / 30"
        android:textColor="@color/white_60"
        android:textSize="13sp"
        android:fontFamily="@font/poppins_regular"
        app:layout_constraintTop_toTopOf="@id/tv_title"
        app:layout_constraintBottom_toBottomOf="@id/tv_title"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="28dp"/>

    <!-- Divider -->
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/white_15"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="28dp"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Quote Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_quote"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="28dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/card_bg"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btn_previous"
        app:layout_constraintVertical_bias="0.45">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp">

            <!-- Large decorative opening quote mark -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#8220;"
                android:textColor="@color/accent_blue"
                android:textSize="64sp"
                android:fontFamily="@font/poppins_bold"
                android:lineHeight="44dp"
                android:layout_marginBottom="-4dp"/>

            <!-- Quote body text -->
            <TextView
                android:id="@+id/tv_quote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:lineSpacingMultiplier="1.6"
                android:fontFamily="@font/poppins_medium"
                tools:text="\u201CThe only way to do great work is to love what you do.\u201D"/>

            <Space android:layout_width="match_parent" android:layout_height="20dp"/>

            <!-- Blue accent line above author -->
            <View
                android:layout_width="36dp"
                android:layout_height="2dp"
                android:background="@color/accent_blue"
                android:layout_marginBottom="12dp"/>

            <!-- Author name -->
            <TextView
                android:id="@+id/tv_author"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:letterSpacing="0.05"
                android:fontFamily="@font/poppins_medium"
                tools:text="— Steve Jobs"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Previous Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_previous"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:text="◀  Prev"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:fontFamily="@font/poppins_medium"
        app:strokeColor="@color/white_30"
        app:strokeWidth="1.5dp"
        app:cornerRadius="26dp"
        app:backgroundTint="@android:color/transparent"
        app:rippleColor="@color/white_15"
        app:layout_constraintBottom_toTopOf="@id/btn_share"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_next"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="12dp"/>

    <!-- Next Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_next"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:text="Next  ▶"
        android:textColor="@color/navy_dark"
        android:textSize="14sp"
        android:fontFamily="@font/poppins_bold"
        app:cornerRadius="26dp"
        app:backgroundTint="@color/accent_blue"
        app:rippleColor="@color/navy_dark"
        app:layout_constraintBottom_toTopOf="@id/btn_share"
        app:layout_constraintStart_toEndOf="@id/btn_previous"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="24dp"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="12dp"/>

    <!-- Share Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_share"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:text="Share"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:fontFamily="@font/poppins_medium"
        android:paddingHorizontal="20dp"
        app:icon="@drawable/ic_share"
        app:iconTint="@color/white"
        app:iconGravity="textStart"
        app:strokeColor="@color/white_30"
        app:strokeWidth="1.5dp"
        app:cornerRadius="26dp"
        app:backgroundTint="@android:color/transparent"
        app:rippleColor="@color/white_15"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="44dp"/>

    <!-- Add Your Quote Button -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/btn_add_quote"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:text="Add Quote"
        android:textColor="@color/navy_dark"
        android:textSize="13sp"
        android:fontFamily="@font/poppins_bold"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/navy_dark"
        app:backgroundTint="@color/accent_blue"
        app:cornerRadius="26dp"
        app:elevation="6dp"
        app:layout_constraintBottom_toBottomOf="@id/btn_share"
        app:layout_constraintTop_toTopOf="@id/btn_share"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="24dp"/>

    <!-- Decorative bottom circle -->
    <View
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:background="@drawable/shape_circle_accent"
        android:alpha="0.06"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="-40dp"
        android:layout_marginStart="-40dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>